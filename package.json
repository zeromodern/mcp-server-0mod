{
  "name": "@zeromodern/mcp-server-0mod",
  "version": "2.0.1",
  "description": "MCP server wrapping the 0mod API Gateway for any AI agent",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "mcp-server-0mod": "./build/index.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node build/index.js",
    "test": "npm run build && node test/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "smithery",
    "x402",
    "0mod",
    "ai-tools"
  ],
  "author": "0mod <https://api.0mod.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeromodern/mcp-server-0mod.git"
  },
  "homepage": "https://github.com/zeromodern/mcp-server-0mod#readme",
  "bugs": {
    "url": "https://github.com/zeromodern/mcp-server-0mod/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "@x402/core": "^2.21.0",
    "@x402/evm": "^2.21.0",
    "@x402/fetch": "^2.21.0",
    "viem": "^2.55.11",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.0.0"
  }
}
